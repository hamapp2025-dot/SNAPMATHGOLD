      "clip": "u1-c2_4-quadratic"
    },
    {
      "t": 62.95,
      "text": "نوحّد المقام ونقارن معاملات القوى.",
      "dur": 2.7,
      "clip": "u1-c2_4-quadratic"
    },
    {
      "t": 65.65,
      "text": "فالبسط فوق التربيعي من الدرجة الأولى.",
