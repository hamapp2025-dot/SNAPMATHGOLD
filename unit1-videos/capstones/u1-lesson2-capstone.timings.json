  "timings": [
    {
      "t": 0.0,
      "text": "كسر واحد صعب نحوّله إلى فرق كسرين بسيطين.",
      "dur": 3.96,
      "clip": "u1-c2_1-idea"
    },
    {
      "t": 3.96,
      "text": "لماذا هذا مفيد؟ لنرَ قوّته في مجموع.",
      "dur": 3.54,
      "clip": "u1-c2_1-idea"
    },
    {
      "t": 7.5,
      "text": "نستبدل كل حد بفرق كسرين.",
      "dur": 2.7,
      "clip": "u1-c2_1-idea"
    },
    {
