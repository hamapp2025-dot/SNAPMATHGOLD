      "clip": "u1-c2_4-quadratic"
    },
    {
      "t": 75.93,
      "text": "طريقة سريعة لإيجاد البسوط المجهولة مباشرة.",
      "dur": 3.12,
      "clip": "u1-c2_5-coverup"
    },
    {
      "t": 79.05,
      "text": "نغطّي القوس ونعوّض جذره لنجد بسطه.",
      "dur": 3.12,
      "clip": "u1-c2_5-coverup"
    },
    {
      "t": 82.17,
      "text": "فنحصل على البسوط بخطوة واحدة لكل عامل.",
